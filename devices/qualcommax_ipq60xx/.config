CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

# 只构建京东云亚瑟 AX1800 Pro 单设备
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=n

# 不要开 CONFIG_TARGET_PER_DEVICE_ROOTFS：
# 打开后设备包会被降级成模块( =m )，镜像阶段 include/image.mk 用 apk 从
# 本地索引 packages.adb 安装它时找不到该包，编译直接失败：
#   ERROR: unable to select packages:
#     ipq-wifi-jdcloud_re-ss-01 (no such package):
#       required by: world[ipq-wifi-jdcloud_re-ss-01]
#   make[5]: *** [.../include/image.mk:397: target-dir-3458f57f] Error 1
#   make[4]: *** [Makefile:39: install] Error 2 → ERROR: target/linux failed to build.
# 关闭后设备包回到 =y，随 rootfs 一起安装；单设备本来也只构建一台。
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 京东云 RE-SS-01 的板级校准数据 board-2.bin（自建普通包，=y）
# 官方 ipq-wifi-jdcloud_re-ss-01 走 install-overlay + 模块化，装不进来
CONFIG_PACKAGE_ipq-wifi-jdcloud=y
