#!/bin/sh /etc/rc.common
# Xray-core 开机自启（命令行模式，不依赖 luci-app-xray）
#
# xray-core 包本身只装 /usr/bin/xray 二进制，不带任何 init 脚本与 UCI 配置。
# 这个脚本由 Kwrt-slim 内置的 base-files 提供，让手写 JSON 配置的 xray
# 也能开机自启、崩溃自动重拉。
#
# 用法：
#   配置文件   /etc/xray/config.json（标准 Xray JSON，不是 UCI）
#   启停       /etc/init.d/xray start|stop|restart|status
#   开机自启   /etc/init.d/xray enable
#
# 注意：默认不 enable。装了包不等于开了服务，避免没配好就在后台反复重启。

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/xray
CONF=/etc/xray/config.json
NAME=xray

start_service() {
	[ -x "$PROG" ] || {
		logger -t xray "not starting: $PROG missing"
		return 1
	}

	[ -f "$CONF" ] || {
		logger -t xray "not starting: $CONF missing"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$CONF"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1000000 1000000"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger xray
}
