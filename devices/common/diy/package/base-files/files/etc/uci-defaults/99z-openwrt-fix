#!/bin/sh
# 首启修正（zram / root 密码 / UPnP / passwall 死链接 / xray 自启）
#
# 文件名 99z- 前缀是刻意的：OpenWrt 在 /etc/uci-defaults 下用
#   files="$(ls)"; for file in $files
# 即字母序执行，因此 99z-openwrt-fix 排在 my-default-settings 的
# 99-default-settings 之后（'9'=0x39 < 'z'=0x7a），能在它之后覆盖设置。

# ---------------------------------------------------------------
# 1) zram 虚拟内存 2G + lz4
#    上游 99-default-settings 会设 zram_size_mb=$((mem/1024/3))（512MB 机器
#    只有 170MB），必须在其之后无条件覆盖，不能用 get 守卫。
# ---------------------------------------------------------------
uci set system.@system[0].zram_size_mb='2048'
uci set system.@system[0].zram_comp_algo='lz4'

# ---------------------------------------------------------------
# 2) root 默认密码：$((echo 147258; echo 147258) | passwd root)
#    上游 99-default-settings:75 会把密码设成 root，这里在其之后覆盖。
# ---------------------------------------------------------------
(echo 147258; echo 147258) | passwd root >/dev/null 2>&1

# ---------------------------------------------------------------
# 3) 关闭上游默认开启的 UPnP（局域网里默认暴露端口映射，个人使用没必要）
# ---------------------------------------------------------------
uci -q set upnpd.config.enabled='0'

# ---------------------------------------------------------------
# 4) 清理 passwall 死链接
#    上游 99-default-settings 在装了 nginx 时会建一个 DHCP 域名劫持条目
#    `pw` 指向 /cgi-bin/luci/admin/services/passwall，但本固件不装
#    passwall，属死链，删掉名为 pw 的 domain 条目。
# ---------------------------------------------------------------
i=0
while uci -q get "dhcp.@domain[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "dhcp.@domain[$i].name")" = "pw" ]; then
		uci -q delete "dhcp.@domain[$i]"
		continue
	fi
	i=$((i + 1))
done

uci -q commit system
uci -q commit upnpd
uci -q commit dhcp

# ---------------------------------------------------------------
# 5) xray 开机自启
#    官方 xray-core 包自带 /etc/init.d/xray 与 /etc/config/xray（UCI），
#    其 init 脚本读 `xray.enabled.enabled`，默认是 0（关闭），开启后按
#    /etc/config/xray 的列表加载 /etc/xray/config.json。
#
#    注意：本固件的 base-files 曾自带一份 /etc/init.d/xray，与官方包
#    争抢同一路径，导致 apk 在 package/install 阶段报
#      ERROR: xray-core: trying to overwrite etc/init.d/xray owned by base-files
#    并中断整个编译。已删除内置脚本，改用官方 init + UCI 开关。
# ---------------------------------------------------------------
uci -q set xray.enabled.enabled='1'
uci -q commit xray

# ---------------------------------------------------------------
# 6) xray 日志目录
#    内置的 /etc/xray/config.json 把 error 日志写到 /var/log/xray/error.log，
#    xray 不会自建目录，缺失时会启动失败。
# ---------------------------------------------------------------
mkdir -p /var/log/xray

exit 0
