# 挂载配置：overlay（extroot）默认用 /dev/mmcblk0p27（storage 剩余空间，最大），
# 若 p27 不存在则自动改用 p28（见 /etc/uci-defaults/96-overlay-extroot）。
# 其余分区按 /mnt/mmcblk0pXX 自动挂载。
# 用户 2026-10-23 决定：不再单独划 p28，空间并回 p27。

config global
	option anon_mount '1'

config mount
	option target '/overlay'
	option device '/dev/mmcblk0p27'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '1'
	option enabled_fsck '0'
