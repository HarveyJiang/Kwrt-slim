#!/bin/sh
# 96-overlay-p28（首次启动执行一次）
#   1) overlay 设备兜底：fstab 里指定的 /dev/mmcblk0p28 不存在时退回 /dev/mmcblk0p27，
#      避免下次启动 overlay 挂不上退回到 p18 里的 loop 小分区；
#   2) 建立便捷路径 /mnt/mmcblk0p28 -> /overlay（OpenWrt 的 overlay 必须挂在 /overlay）。

[ -x /sbin/uci ] || exit 0

section=""
for s in $(uci -q show fstab 2>/dev/null | sed -n "s/^fstab\.\([^.=]*\)\.target='\/overlay'$/\1/p"); do
	section="$s"
done

if [ -n "$section" ]; then
	dev="$(uci -q get fstab.$section.device)"
	if [ "$dev" = "/dev/mmcblk0p28" ] && [ ! -b /dev/mmcblk0p28 ] && [ -b /dev/mmcblk0p27 ]; then
		uci -q set fstab.$section.device='/dev/mmcblk0p27'
		uci -q commit fstab
		logger -t overlay "p28 不存在，overlay 回退到 p27"
	fi
fi

[ -e /mnt/mmcblk0p28 ] || ln -sfn /overlay /mnt/mmcblk0p28 2>/dev/null

exit 0
