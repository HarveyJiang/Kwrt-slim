#!/bin/sh
# 96-overlay-extroot（首次启动执行一次）
#   布局：p28 = overlay（511MiB），p27 = 数据盘（/mnt/mmcblk0p27）。
#
#   ⚠️ 用户要求（2026-10-23）：overlay 固定用 p28，**不回退到 p27**。
#   所以这里不做任何"p28 不在就换设备"的改写；p28 缺失或挂不上时，
#   mount_root 会自然退回 p18 里的内置 loop overlay（约 34MB），fstab 保持不变，
#   下次启动行为不会漂移。只在日志里留一条告警，方便定位。
#
#   另外做两件事：
#   1) 建便捷路径 /mnt/mmcblk0p28 -> /overlay（OpenWrt 只认 /overlay 这个挂载点）；
#   2) overlay 结构自愈：ext4 extroot 需要 /overlay/upper 与 /overlay/work，
#      从别处挪过来、或分区里有旧数据时这两个目录可能不存在，补建（不删数据）。

[ -x /sbin/uci ] || exit 0

# 1) 便捷路径
[ -e /mnt/mmcblk0p28 ] || ln -sfn /overlay /mnt/mmcblk0p28 2>/dev/null

# 2) 实际挂载在 /overlay 的是哪块设备？（loop overlay 时为空）
ovl_dev="$(mount | sed -n 's|^\(/dev/[^ ]*\) on /overlay .*|\1|p')"

if [ -n "$ovl_dev" ] && [ "$ovl_dev" != "/dev/mmcblk0p28" ]; then
	logger -t overlay "警告：overlay 实际挂在 $ovl_dev（应为 /dev/mmcblk0p28），fstab 未改动"
elif [ -z "$ovl_dev" ]; then
	logger -t overlay "警告：/overlay 不是独立块设备（内置 loop overlay），请检查 p28 是否已格式化"
fi

# 3) overlay 结构自愈
if [ -d /overlay ] && { [ ! -d /overlay/upper ] || [ ! -d /overlay/work ]; }; then
	mkdir -p /overlay/upper /overlay/work
	logger -t overlay "overlay 缺少 upper/work，已补建；分区里若有旧数据建议格式化"
fi

exit 0
