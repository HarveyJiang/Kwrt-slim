#!/bin/sh
# 96-overlay-extroot（首次启动执行一次）
#   布局：p28 = overlay（511MiB，会被刷机重置），p27 = 数据盘挂 /mnt/mmcblk0p27。
#   1) 兜底：p28 不存在时把 overlay 换到 p27，同时停用 p27 的数据盘挂载
#      （同一块设备不能既做 overlay 又挂到 /mnt），避免下次启动 overlay 挂不上、
#      退回 p18 里的 loop 小分区（约 34MB）；
#   2) 给 overlay 设备建便捷路径 /mnt/mmcblk0p28 -> /overlay（OpenWrt 只认 /overlay）。

[ -x /sbin/uci ] || exit 0

overlay_sec=""
data_sec=""
for s in $(uci -q show fstab 2>/dev/null | sed -n "s/^fstab\.\([^.=]*\)\.target='\/overlay'$/\1/p"); do
	overlay_sec="$s"
done
for s in $(uci -q show fstab 2>/dev/null | sed -n "s/^fstab\.\([^.=]*\)\.target='\/mnt\/mmcblk0p27'$/\1/p"); do
	data_sec="$s"
done

if [ -n "$overlay_sec" ]; then
	dev="$(uci -q get fstab.$overlay_sec.device)"

	# p28 缺失 → 用 p27 顶替 overlay，并停用数据盘挂载，避免重复挂同一块设备
	if [ "$dev" = "/dev/mmcblk0p28" ] && [ ! -b /dev/mmcblk0p28 ] && [ -b /dev/mmcblk0p27 ]; then
		uci -q set fstab.$overlay_sec.device='/dev/mmcblk0p27'
		[ -n "$data_sec" ] && uci -q set fstab.$data_sec.enabled='0'
		uci -q commit fstab
		logger -t overlay "p28 不存在，overlay 回退到 p27，数据盘挂载已停用"
		dev="/dev/mmcblk0p27"
	fi

	case "$dev" in
		/dev/mmcblk0p28) mp=/mnt/mmcblk0p28 ;;
		/dev/mmcblk0p27) mp=/mnt/mmcblk0p27 ;;
		*) mp="" ;;
	esac
	[ -n "$mp" ] && [ ! -e "$mp" ] && ln -sfn /overlay "$mp" 2>/dev/null
fi

# overlay 结构自愈：ext4 extroot 需要 /overlay/upper 与 /overlay/work。
# 典型问题：把一个装过别的东西的分区直接拿来当 overlay（比如 p28 里原来是
# alist/aria2 的数据），没有 upper/work，overlayfs 的读写层就落不到位。
# 这里只补建目录、不删任何数据；旧文件仍占着分区空间，建议刷机前格式化一次：
#   mkfs.ext4 -F -L kwrtdata /dev/mmcblk0p28
if [ -d /overlay ] && { [ ! -d /overlay/upper ] || [ ! -d /overlay/work ]; }; then
	mkdir -p /overlay/upper /overlay/work
	logger -t overlay "overlay 缺少 upper/work，已补建；分区里若有旧数据建议格式化"
fi

exit 0
