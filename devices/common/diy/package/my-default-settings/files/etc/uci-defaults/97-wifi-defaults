#!/bin/sh
# 首次启动 / sysupgrade 后兜底设置无线「国标」项（用户 2026-10-24 决定）：
#   只设 wifi-device 的 country=CN 与 2.4G txpower=20（regulatory，非身份凭据）。
#   SSID / 加密 / 密码由用户在 LuCI 或命令行自行设置，固件一律不再写入，
#   避免再出现无线被禁用/被改坏的情况。

[ -f /etc/config/wireless ] || exit 0
command -v uci >/dev/null 2>&1 || exit 0

for sec in $(uci -q show wireless 2>/dev/null | sed -n 's/^\(wireless\.[^=]*\)=wifi-device$/\1/p'); do
	uci -q set "wireless.$sec.country"='CN'
	case "$(uci -q get "wireless.$sec.band")" in
		2g|2G) uci -q set "wireless.$sec.txpower"='20' ;;
	esac
done
uci -q commit wireless
logger -t wifi-defaults "无线国标已设置：country=CN、2.4G=20dBm（SSID/密码未动）"

exit 0
