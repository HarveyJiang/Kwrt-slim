
CONFIG_GRUB_TIMEOUT="0"
CONFIG_GRUB_CONSOLE=n
CONFIG_TARGET_ROOTFS_EXT4FS=n

CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_LUCI_CSSTIDY=n
CONFIG_SIGNED_PACKAGES=n
CONFIG_SIGNATURE_CHECK=n

CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y

# 设置固件大小:
CONFIG_TARGET_ROOTFS_PARTSIZE=1004

CONFIG_ALL_NONSHARED=y

CONFIG_USE_APK=y

CONFIG_BUILD_PATENTED=y

CONFIG_IB=y
CONFIG_IB_STANDALONE=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

CONFIG_FEED_telephony=n

CONFIG_KERNEL_WERROR=n

# IPv6支持:
CONFIG_IPV6=y

# Applications


# Themes


# 其他需要安装的软件包:

CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y

CONFIG_PACKAGE_firewall=m
CONFIG_PACKAGE_miniupnpd-iptables=m

CONFIG_NGINX_DAV=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y
CONFIG_PACKAGE_coremark=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=16
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_my-default-settings=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_XRAY_PROVIDE_V2RAY=y
CONFIG_V2RAY_CORE_COMPRESS_UPX=n
CONFIG_XRAY_CORE_COMPRESS_UPX=n
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-zstd=y
# zram 虚拟内存：2G，lz4 压缩（速度快、CPU 占用低）
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_XARGS_SUPPORT_REPL_STR=y
CONFIG_BUSYBOX_CONFIG_FEATURE_CROND_SPECIAL_TIMES=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG_INFO=y

CONFIG_PACKAGE_luci-nginx=y # nginx服务

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y

CONFIG_PACKAGE_wifi-scripts=m

# CONFIG_PACKAGE_netdata=m

# ==========================================================
# 存储 / USB / 文件共享
# ==========================================================

# USB 3.0 驱动：kmod-usb-dwc3-qcom 已在 target DEFAULT_PACKAGES 中，无需重复
# UUID 挂载：block-mount + blkid（mount-utils 在 25.12 已不存在）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blockdev=y

# U 盘 / 移动硬盘
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# 文件系统：ext4/f2fs 已在 target DEFAULT_PACKAGES 中
CONFIG_PACKAGE_kmod-fs-vfat=y          # FAT32/exFAT 兼容旧 U 盘
CONFIG_PACKAGE_kmod-fs-ntfs3=y         # 内核 6.12 新 NTFS 驱动，读写快
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y

# 磁盘工具
CONFIG_PACKAGE_ncdu=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y            # 打包成 .zip（Info-ZIP，已内置 devices/common/diy/package/zip）
CONFIG_PACKAGE_unrar=y         # 解 .rar（官方 packages feed）
CONFIG_PACKAGE_luci-app-hd-idle=y      # 硬盘休眠

# SMB 共享：kmod-fs-ksmbd（内核模块）+ ksmbd-server/tools（用户态）
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-tools=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_wsdd2=y                 # Windows 网上邻居发现

# ==========================================================
# 下载 / 文件管理
# ==========================================================

CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-aria2=y

# OpenList（Alist 继任者），已内置 devices/common/diy/package/openlist
# 取自官方上游 OpenListTeam/OpenList-OpenWRT，不再依赖第三方 feed
CONFIG_PACKAGE_openlist=y
CONFIG_PACKAGE_luci-app-openlist=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-timeout=y

# ==========================================================
# 代理（轻量，支持 xray 节点）
# ==========================================================

# xray-core：只装命令行二进制 /usr/bin/xray（Go 静态编译，常驻约 20-30MB）
# 不要图形界面，配置文件与启动脚本自行维护（标准 JSON 配置，非 UCI）
# 已移除 luci-app-xray（含 tproxy 透明代理、nftables 规则、开机服务）及配套
# kmod-nft-tproxy / kmod-tun / ip-full / ucode-mod-digest —— 都是界面才需要的
CONFIG_PACKAGE_xray-core=y
# 可选：sing-box + homeproxy（界面更现代，体积更大，默认关闭）
# CONFIG_PACKAGE_luci-app-homeproxy=y
# CONFIG_PACKAGE_sing-box=y

# ==========================================================
# Docker
# ==========================================================

CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_fuse-overlayfs=y
CONFIG_PACKAGE_luci-app-dockerman=y

CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y

CONFIG_VERSION_MANUFACTURER="HarveyJiang"
CONFIG_VERSION_FILENAMES=n
CONFIG_VERSION_CODE_FILENAMES=n
CONFIG_VERSION_HOME_URL="https://openwrt.org/"
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12-SNAPSHOT"

CONFIG_ZLIB_OPTIMIZE_SPEED=y


# start dockerd
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y
CONFIG_KERNEL_CGROUP_PERF=y
CONFIG_KERNEL_CGROUP_HUGETLB=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_BTRFS_FS_POSIX_ACL=y
# end dockerd


CONFIG_PACKAGE_kselftests-bpf=n

CONFIG_BPF_TOOLCHAIN_HOST=y